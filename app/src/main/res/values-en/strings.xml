    <string name="cfg_mirror_hint">Mirror at mod.mcimirror.top, API-compatible with the official one. Used automatically for search and download when no CurseForge key is set.</string>
    <string name="cfg_auto_launch">Open launcher automatically when migration finishes</string>
    <string name="cfg_trans_hint">Uses the free MyMemory API (en to zh-CN), about 5000 words/day anonymously. The Translate button under a description translates or restores a single entry.</string>
    <string name="account_hint_logged_out">Backend reachable. Sign in to enable sync and download</string>
    <string name="conn_blocked_hint">Cannot reach the backend: Cloudflare is often throttled in mainland China. Offline features still work. Try another network or retry later.</string>
    <string name="cfg_offline_hint">When on, no network request is made at all: search and download are unavailable, migration and editing still work. This differs from turning the backend off - that only switches to your own key and still goes online.</string>
    <string name="cfg_backend_hint">Leave empty to use the default address. The backend handles GitHub sign-in and CurseForge proxying, so you don\'t need your own key.</string>
    <string name="cfg_workdir_hint">After granting a folder, exported packs, downloads, config backups and the translation cache all go there so you can manage them yourself.</string>
    <string name="cfg_pick_workdir">Pick working folder</string>
    <string name="cfg_clear_workdir">Clear working folder</string>
