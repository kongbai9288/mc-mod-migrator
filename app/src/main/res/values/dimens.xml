<?xml version="1.0" encoding="utf-8"?>
<!--
  按设备可用高度分档的尺寸。

  之前结果列表写死 240dp，在矮屏上把页面挤爆、在平板和高屏上又空一大块。
  这里只放「跟屏幕高度有关」的那一类尺寸，其余一律写死不参与分档。

  分档依据 Android 的可用高度限定符 -h<N>dp（切横屏时高度变小，自动落回小档）：
    values-h840dp  高屏手机 / 折叠屏展开
    （默认）       常规手机竖屏
    values-land    横屏
    values-sw600dp 平板 / 折叠屏展开（sw 优先级高于 h，所以平板走这一档）
-->
<resources>
    <!-- 迁移页「识别结果」列表的高度 -->
    <dimen name="mig_result_h">240dp</dimen>
</resources>
