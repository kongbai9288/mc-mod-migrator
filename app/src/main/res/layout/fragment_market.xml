<?xml version="1.0" encoding="utf-8"?>
<!--
  市场页重排。

  原来的问题：
    · 整个页面是一根竖条，搜索、推荐、收藏、分享、打开网页全平铺，
      没有主次，一屏塞不下。
    · 「收藏的链接」列表高度不限（wrap_content），链接一多就把下面
      的搜索结果整体顶出屏幕 —— 表现就是"搜完看不到结果"。
    · 结果列表拿到的是剩余空间，上面被占多少它就少多少。

  重排后：
    · 顶部配置区独立滚动，最多占 1/3 屏，滚多少都不影响结果列表。
    · 「排序」行固定在结果列表上方，永远露在外面（之前会被顶飞）。
    · 结果列表固定拿 2/3 屏，不再被上面的内容挤没。

  ⚠️ 两个约束，改之前先看懂：
    1. 所有 android:id 保持不变，MarketFragment.kt 里 findViewById 用的还是这些。
    2. 「排序」那一行（tvListTitle / spSort 所在的 horizontal LinearLayout）
       的直接父容器必须是 LinearLayout —— 代码里靠
       `tvListTitle.parent` 再 `.parent` 两层往上找，把分类筛选行插在
       排序行下面。外面套一层非 LinearLayout 的容器，筛选行就会回退插进
       横向行里，把排序挤飞（v2.2.5 修过的那个 bug）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 配置区：自己滚，最多 1/3 屏 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etQuery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_query"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spLoader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:entries="@array/loaders" />

                <EditText
                    android:id="@+id/etVersion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:hint="1.20.1"
                    android:inputType="text"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_search" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRecommend"
                    style="@style/AppButtonOutlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_recommend" />

                <Button
                    android:id="@+id/btnFavorites"
                    style="@style/AppButtonOutlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_favorites" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="@string/market_tips"
                android:textColor="@color/textSecondary"
                android:textSize="11sp" />

            <!-- 收藏与分享：次要操作，收在一行里，不再各自占一行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAddLink"
                    style="@style/AppButtonOutlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_add_link" />

                <Button
                    android:id="@+id/btnShare"
                    style="@style/AppButtonOutlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/btn_share_position" />

                <Button
                    android:id="@+id/btnOpenPage"
                    style="@style/AppButtonOutlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/btn_open_page" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/marked_links"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLinks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:overScrollMode="never" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 排序行：固定在结果列表上方，不随配置区滚动 ⚠️ 父容器必须是 LinearLayout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvListTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/search_results"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_sort"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:entries="@array/sort_modes" />
    </LinearLayout>

    <!-- 结果列表：固定拿 2/3 屏，不再被上面的内容顶掉 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMods"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />
</LinearLayout>
