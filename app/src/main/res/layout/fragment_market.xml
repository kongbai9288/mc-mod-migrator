<?xml version="1.0" encoding="utf-8"?>
<!--
  市场页。

  这一版把「筛选」从页面上挪走了。之前是上半屏一堆输入框、
  下半屏一个列表，两边按写死的比例分屏：上面只给三分之一，
  参数一多就在那点地方来回滚，看着像"显示不全"；列表被压成
  两行，又像"搜不到东西"。为了缓解还加过一个手动切换布局的
  按钮 —— 那不是同类应用的做法，越加越怪。

  现在的形态跟应用商店一致：
    · 搜索框常驻顶部，任何时候都能直接打字回车
    · 筛选条件收进底部抽屉，点「筛选」弹出，选完自动收起
    · 已生效的条件（分类等）以一排标签显示在搜索框下面，可单独点掉
    · 列表吃满整屏，不再和任何东西抢高度

  ⚠️ 保留的 id：etQuery / btnSearch / tvListTitle / spSort /
     btnFavorites / rvMods，MarketFragment.kt 里 findViewById 用的还是这些。
     spLoader、etVersion、btnRecommend、rvLinks、btnAddLink、btnShare、
     btnOpenPage 已经移到 sheet_market_filter.xml，只在抽屉弹出时存在。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 搜索栏：常驻，不随任何东西折叠 -->
    <LinearLayout
        android:id="@+id/rowSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etQuery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_query"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/btn_search" />

        <TextView
            android:id="@+id/btnFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="筛选"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 结果标题 + 排序 + 收藏页签 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvListTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/search_results"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFavorites"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/btn_favorites"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_sort"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:entries="@array/sort_modes" />
    </LinearLayout>

    <!-- 结果列表：吃满剩下的全部高度 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMods"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
