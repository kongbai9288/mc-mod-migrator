<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="面板连接（Pterodactyl Client API）"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etPanelBase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="面板地址，如 https://panel.example.com"
        android:inputType="textUri"
        android:singleLine="true" />

    <EditText
        android:id="@+id/etPanelKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Client API Key（ptlc_...）"
        android:inputType="textPassword"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/panel_auth_hint"
        android:textColor="@color/textSecondary"
        android:textSize="12sp" />

    <!-- 连接方式：面板 API（要 ptlc_ Key）或 FTP/SFTP（用账号密码）。
         面板 API 不是每台服务器都有，而 FTP/SSH 基本是标配，
         没有面板 Key 时至少有路可走。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="连接方式：" />

        <Spinner
            android:id="@+id/spRemoteKind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:entries="@array/remote_kinds" />
    </LinearLayout>

    <!-- FTP/SFTP 的连接参数。选了面板 API 时整块隐藏，不占地方。 -->
    <LinearLayout
        android:id="@+id/boxRemote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etRemoteHost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:hint="主机，如 1.2.3.4 或 srv.example.com"
                android:inputType="text"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etRemotePort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="端口"
                android:inputType="number"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etRemoteUser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="用户名"
                android:inputType="text"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etRemotePass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="密码"
                android:inputType="textPassword"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="用服务器的 FTP/SSH 账号密码直连，可以浏览并读取 mods、plugins 目录。端口留空用默认值（FTP 21 / SFTP 22）。"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnConnect"
        style="@style/AppButtonOutlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="连接并选择服务器" />

    <TextView
        android:id="@+id/tvServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="未选择服务器"
        android:textColor="@color/textSecondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etPanelDir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="/mods 或 /plugins"
            android:inputType="text"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnScanFiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/panel_scan" />

        <Button
            android:id="@+id/btnProbeDir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/panel_probe_dir" />
    </LinearLayout>

    <Button
        android:id="@+id/btnBrowseDir"
        style="@style/AppButtonOutlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="浏览目录（逐级进入，边逛边看 jar）" />

    <Button
        android:id="@+id/btnPickOutDir"
        style="@style/AppButtonOutlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="存放位置：默认" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etVersion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="服务器 MC 版本"
            android:inputType="text"
            android:singleLine="true" />

        <Spinner
            android:id="@+id/spLoader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:entries="@array/loaders" />

        <Spinner
            android:id="@+id/spSide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:entries="@array/sides" />

        <Button
            android:id="@+id/btnCheckUpdates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="检测更新" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDownloadAll"
        style="@style/AppButtonOutlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="一键下载全部更新（不自动上传）" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="更新列表"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUpdates"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="120dp"
        android:textColor="@color/textSecondary"
        android:textSize="12sp" />
</LinearLayout>
