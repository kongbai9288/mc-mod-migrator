<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rowAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_person" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_not_login"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvConnState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/account_login" />

        <Button
            android:id="@+id/btnGoBackend"
            style="@style/AppButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_backend" />

        <Button
            android:id="@+id/btnGoSearch"
            style="@style/AppButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_search" />

        <Button
            android:id="@+id/btnGoMigrate"
            style="@style/AppButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_migrate" />

        <Button
            android:id="@+id/btnGoLab"
            style="@style/AppButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_lab" />

        <Button
            android:id="@+id/btnGoTranslate"
            style="@style/AppButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_translate" />

        <Button
            android:id="@+id/btnGoNav"
            style="@style/AppButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_nav" />

        <Button
            android:id="@+id/btnGoStorage"
            style="@style/AppButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_storage" />

        <Button
            android:id="@+id/btnGoAbout"
            style="@style/AppButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_about" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="@string/cfg_update" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/cfg_update_hint"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swOffline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cfg_offline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/cfg_offline_hint"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <!-- 断网细分：总开关关闭时，这几个分项才生效 -->
        <TextView
            android:id="@+id/tvOfflineParts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="单独关闭某一项的联网"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swOfflineSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="商店搜索与推荐" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swOfflineTranslate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="在线翻译（关掉后只用本地词典）" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swOfflineFeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="资讯抓取" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swOfflineUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="更新检查" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swOfflineAnnounce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="公告拉取" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="上面的总开关打开时，所有联网一律关闭，分项不再单独判断。"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swExtraLoaders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="在加载器分类里显示手机不支持的加载器" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="如 Cleanroom / LiteLoader / Rift / Risugami / BTA。默认关闭：这些大多停在 1.12.2 及更早或已停更，手机上装了也跑不起来。开启后仅用于识别已有模组，不代表能运行。"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
