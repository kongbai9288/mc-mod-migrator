<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLogSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@android:color/transparent"
            android:text="暂无日志"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sec_source"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/empty_hint"
                    android:textColor="@color/textSecondary" />

                <Button
                    android:id="@+id/btnScanLocal"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_scan_local" />

                <Button
                    android:id="@+id/btnPickLauncher"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cfg_pick_launcher" />

                <TextView
                    android:id="@+id/tvScanHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_launcher_dir_hint"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPickSource"
                    style="@style/AppButtonOutlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pick_source" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sec_target"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTargetVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="@string/hint_mc_version"
                    android:inputType="text"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/loader" />

                    <Spinner
                        android:id="@+id/spLoader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:entries="@array/loaders" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/empty_hint"
                    android:textColor="@color/textSecondary" />

                <Button
                    android:id="@+id/btnPickTarget"
                    style="@style/AppButtonOutlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pick_target" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <CheckBox android:id="@+id/cbConfig" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="@string/copy_config" />
                <CheckBox android:id="@+id/cbScripts" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="@string/copy_scripts" />
                <CheckBox android:id="@+id/cbOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="@string/copy_options" />
                <CheckBox android:id="@+id/cbPacks" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_packs" />
                <CheckBox android:id="@+id/cbSaves" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_saves" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
            主次分开：扫描是"先看方案"，执行才是这一步的目的。
            之前两个都用填充样式，看着一样重，
            真正要点的那个反而淹没在一排按钮里。
        -->
        <Button
            android:id="@+id/btnScan"
            style="@style/AppButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_scan" />

        <Button
            android:id="@+id/btnDownloadAll"
            style="@style/AppButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_download_all" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDoctor"
                style="@style/AppButtonOutlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tool_doctor" />

            <Button
                android:id="@+id/btnDiff"
                style="@style/AppButtonOutlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tool_diff" />
        </LinearLayout>

        <!-- 执行迁移是这一页的主操作：用填充样式，一眼能看到 -->
        <Button
            android:id="@+id/btnRun"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="@string/btn_run" />

        <!--
            任务运行中的暂停 / 继续 / 中止。
            ⚠️ 这四个 id 是 MigrationFragment 里实打实在用的
            （rowPause / btnPause / btnCancelTask / btnMigTools），
            之前只改了 Kotlin 没同步布局，编译直接 unresolved reference。
            默认 GONE，任务跑起来才显示，平时不占地方。
        -->
        <LinearLayout
            android:id="@+id/rowPause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnPause"
                style="@style/AppButtonOutlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="暂停" />

            <Button
                android:id="@+id/btnCancelTask"
                style="@style/AppButtonOutlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="中止" />
        </LinearLayout>

        <!-- 迁移相关工具：把散在工具箱里的迁移类功能从这一页直接够到 -->
        <Button
            android:id="@+id/btnMigTools"
            style="@style/AppButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="迁移相关工具" />

        <ProgressBar
            android:id="@+id/pb"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tab_migration"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/log_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
