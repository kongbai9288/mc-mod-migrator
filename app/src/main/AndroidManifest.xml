<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 8.0(API 26)+ 安装未知来源应用**必须**声明这个权限。
         本项目 targetSdk 34 / minSdk 26，缺了它，下载完 APK 后
         startActivity(ACTION_VIEW) 会被系统直接拒绝（静默失败或抛
         SecurityException）—— 这正是"点去更新没反应/崩一下"的根因。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="net.kdt.pojavlaunch" />
        <package android:name="com.movtery.zalithlauncher" />
        <package android:name="com.aof.mcinabox" />
        <package android:name="com.mojang.minecraftpe" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        android:theme="@style/Theme.ModMigrator">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ModPageActivity"
            android:exported="false"
            android:label="@string/title_mod_page"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SettingsHostActivity"
            android:exported="false"
            android:label="@string/tab_settings"
            android:screenOrientation="portrait" />

        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:label="@string/editor_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:label="@string/cfg_pick_launcher"
            android:screenOrientation="portrait" />

        <!--
          OAuth 回调落点。
          mm://oauth/callback 需要在 GitHub OAuth App 的回调地址里额外登记一条；
          自定义 scheme 浏览器处理不了，会交回系统再送到这里。
          https 那条是后端中转流程的地址，App Links 生效时也能接住。
        -->
        <activity
            android:name=".OAuthRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="mm"
                    android:host="oauth"
                    android:pathPrefix="/callback" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="modmarket.3566500461.workers.dev"
                    android:pathPrefix="/api/auth/callback" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CloudDriveActivity"
            android:exported="false"
            android:label="云盘"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DevLabActivity"
            android:exported="false"
            android:label="开发者模式"
            android:screenOrientation="portrait" />

        <activity
            android:name=".InfoActivity"
            android:exported="false"
            android:label="@string/title_info"
            android:screenOrientation="portrait" />

        <activity
            android:name=".WebActivity"
            android:exported="false"
            android:label="@string/title_browser"
            android:screenOrientation="portrait" />

        <activity
            android:name=".NbtViewerActivity"
            android:exported="false"
            android:label="NBT 编辑器"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DatapackActivity"
            android:exported="false"
            android:label="数据包生成器"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MisodeActivity"
            android:exported="false"
            android:label="数据包生成器（全部）"
            android:screenOrientation="portrait"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ChunkMapActivity"
            android:exported="false"
            android:label="区块编辑器"
            android:screenOrientation="portrait" />
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
    </application>

</manifest>
